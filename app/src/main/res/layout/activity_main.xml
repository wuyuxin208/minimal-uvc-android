<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <SurfaceView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- 仅在没有有效视频帧时显示；有画面后整层隐藏。菜单始终通过长按打开。 -->
    <FrameLayout
        android:id="@+id/no_signal_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/no_signal_background"
        android:importantForAccessibility="yes">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_no_signal" />

            <TextView
                android:id="@+id/no_signal_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:text="@string/no_signal"
                android:textColor="#F0F2F6"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/signal_connection_hint"
                android:textColor="#8D94A1"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/menu_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="32dp"
            android:padding="12dp"
            android:text="@string/menu_hint"
            android:textColor="#777F8E"
            android:textSize="12sp" />
    </FrameLayout>
</FrameLayout>
